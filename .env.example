# One ChemWiz application. npm install creates .env once with a random JWT secret.
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
APP_URL=http://localhost:5000
DATA_MODE=local
LOCAL_DATA_FILE=data/local-db.json
JWT_SECRET=
JWT_EXPIRES_IN=7d
MONGODB_URI=

# Fresh local test accounts. Existing imported accounts retain their passwords.
LOCAL_ADMIN_EMAIL=admin@chemwiz.local
LOCAL_ADMIN_PASSWORD=ChemWiz-local-Admin!2026
LOCAL_STUDENT_EMAIL=student@chemwiz.local
LOCAL_STUDENT_PASSWORD=ChemWiz-local-Student!2026

# Optional, backend-only Wiz configuration. Copy your working settings here.
OPENAI_API_KEY=
AI_MODEL=gpt-5-mini
AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AI_DAILY_MESSAGE_LIMIT=20
AI_DAILY_VOICE_LIMIT=20
AI_LIVE_IN_LOCAL_MODE=false
AI_LIVE_VOICE_ENABLED=false
AI_REALTIME_MODEL=gpt-realtime-2.1-mini
AI_DAILY_LIVE_SESSIONS_LIMIT=3
PAYMENT_PROVIDER=manual

# Optional extra origins for a later Capacitor wrapper. Web workspaces need none.
FRONTEND_URLS=
# Set to 1 only behind one trusted reverse proxy, as described in README.md.
TRUST_PROXY=0

# EmailJS recovery: backend-only keys. Never use a VITE_ prefix.
EMAILJS_SERVICE_ID=
EMAILJS_RESET_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Optional separate notification template, containing no reset token/password.
EMAILJS_PASSWORD_CHANGED_TEMPLATE_ID=
